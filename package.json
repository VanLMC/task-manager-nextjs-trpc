    "@tanstack/react-query": "5.108.4",
    "@trpc/client": "11.29.11",
    "@trpc/server": "11.29.11",
    "@trpc/tanstack-react-query": "11.29.11",
    "client-only": "0.0.1",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "superjson": "2.2.7",
    "zod": "4.6.7"
